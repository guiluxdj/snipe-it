+        $this->authorize('view', User::class);
+
+        $users = User::orderBy('last_name')
+            ->with('accessories')
+            ->with('assets')
+            ->with('licenses')
+            ->get();
+
+        return view('users/printall')->with('users', $users)
+            ->with('settings', Setting::getSettings());
+    }
